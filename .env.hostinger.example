# TriStellar HRIS — production settings for Hostinger.
# On the server: copy this file to `.env`, fill in the values marked CHANGE,
# then run `php artisan key:generate --force`.

APP_NAME="TriStellar HRIS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# CHANGE: your site address (the temporary *.hostingersite.com domain for now), with https://
APP_URL=https://your-site.hostingersite.com
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=error

# CHANGE: from hPanel → Databases → MySQL Databases (names start with u123456789_)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u000000000_hris
DB_USERNAME=u000000000_hris
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Payroll / timekeeping (see config/hris.php)
HRIS_WORKING_DAYS_PER_YEAR=313
HRIS_LATE_GRACE_MINUTES=0
